{
  "mcp": {
    "figma": {
      "servers": {
        "figma": {
          "type": "remote",
          "url": "https://mcp.figma.com/mcp",
          "disabled": false
        },
        "jira": {
          "type": "remote",
          "url": "https://mcp.atlassian.com/v1/mcp/authv2",
          "disabled": false
        },
        "datadog": {
          "type": "remote",
          "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp?toolsets=all",
          "disabled": false
        },
        "contentful": {
          "type": "remote",
          "url": "https://mcp.eu.contentful.com/mcp",
          "disabled": false
        },
        "headroom": {
          "type": "local",
          "command": [
            "/home/jtw/.local/bin/headroom",
            "mcp",
            "serve"
          ],
          "disabled": false
        },
        "codebase-memory-mcp": {
          "disabled": false,
          "type": "local",
          "command": [
            "/home/jtw/.local/bin/codebase-memory-mcp"
          ]
        }
      }
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/jtw/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "providers": {
    "headroom": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "settings": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
