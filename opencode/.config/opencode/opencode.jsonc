{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/LEARNINGS.md"
  ],
  "providers": {
    "github-copilot": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 50000,
            "output": 8000
          }
        },
        "grok-4.6": {
          "limit": {
            "context": 50000,
            "output": 8000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 50000,
            "output": 8000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": 8000
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "github-copilot",
        "effect": "allow"
      }
    ]
  },
  "default_agent": "plan",
  "agents": {
    "plan": {
      "color": "#9ECE6A"
    },
    "build": {
      "color": "#7DCFFF"
    },
    "coding": {
      "color": "#7AA2F7"
    },
    "explore": {
      "color": "#BB9AF7"
    },
    "figma": {
      "color": "#F7768E"
    },
    "jira": {
      "color": "#FF9E64"
    },
    "datadog": {
      "color": "#632CA6"
    },
    "contentful": {
      "color": "#14D8CC"
    },
    "moneybox-investigation": {
      "color": "#73DACA"
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/w",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/w/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.config/opencode/MEMORY.md",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.config/opencode/LEARNINGS.md",
      "effect": "allow"
    },
    {
      "action": "figma_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "jira_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "datadog_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "contentful_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "jira": {
        "disabled": true,
        "type": "local",
        "command": [
          "uvx",
          "--python=3.12",
          "mcp-atlassian"
        ],
        "environment": {
          "JIRA_URL": "{env:JIRA_URL}",
          "JIRA_USERNAME": "{env:JIRA_USERNAME}",
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
          "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
          "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
          "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}"
        }
      },
      "contentful": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.eu.contentful.com/mcp"
      },
      "datadog": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp?toolsets=all"
      },
      "figma": {
        "disabled": true,
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-mcp"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        }
      },
      "codebase-memory-mcp": {
        "disabled": false,
        "type": "local",
        "command": [
          "/home/jtw/.local/bin/codebase-memory-mcp"
        ]
      },
      "headroom": {
        "disabled": false,
        "type": "local",
        "command": [
          "/home/jtw/.local/bin/headroom",
          "mcp",
          "serve"
        ]
      }
    }
  },
  "lsp": {
    "oxlint": {
      "command": [
        "./node_modules/.bin/oxlint",
        "--lsp"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    },
    "vtsls": {
      "command": [
        "~/.local/share/nvim/mason/packages/vtsls/node_modules/.bin/vtsls",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  }
}
